{
  "name": "invest-track",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "tsx server/index.js",
    "seed": "node scripts/seed_data.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:record": "cp data_bak/invest_track_v2.db data_test/ && DB_PATH=./data_test/invest_track_v2.db RECORD_MODE=true vitest run tests/integration/api-regression.test.js",
    "test:regression": "cp data_bak/invest_track_v2.db data_test/ && DB_PATH=./data_test/invest_track_v2.db vitest run tests/integration/api-regression.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "lru-cache": "^11.2.5",
    "lucide-react": "^0.344.0",
    "node-cron": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "recharts": "^2.12.2",
    "remark-gfm": "^4.0.1",
    "sqlite3": "^5.1.7",
    "undici": "^7.20.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.1.6",
    "vitest": "^4.0.18"
  }
}
